<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>column_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@columns@</string>
        <key>columns</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d 个字段</string>
            <key>other</key>
            <string>%d 个字段</string>
        </dict>
    </dict>
    <key>column_count_short</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@columnsShort@</string>
        <key>columnsShort</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d 字段</string>
            <key>other</key>
            <string>%d 字段</string>
        </dict>
    </dict>
    <key>affected_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rows@</string>
        <key>rows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>影响 %d 行</string>
            <key>other</key>
            <string>影响 %d 行</string>
        </dict>
    </dict>
    <key>row_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rows@</string>
        <key>rows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d 行</string>
            <key>other</key>
            <string>%d 行</string>
        </dict>
    </dict>
    <key>metric_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@metrics@</string>
        <key>metrics</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d 个指标</string>
            <key>other</key>
            <string>%d 个指标</string>
        </dict>
    </dict>
    <key>connection_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@connections@</string>
        <key>connections</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d 个连接</string>
            <key>other</key>
            <string>%d 个连接</string>
        </dict>
    </dict>
</dict>
</plist>
