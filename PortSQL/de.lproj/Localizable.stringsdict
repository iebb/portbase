<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>column_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@columns@</string>
        <key>columns</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d Spalte</string>
            <key>other</key>
            <string>%d Spalten</string>
        </dict>
    </dict>
    <key>column_count_short</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@columnsShort@</string>
        <key>columnsShort</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d Sp.</string>
            <key>other</key>
            <string>%d Sp.</string>
        </dict>
    </dict>
    <key>row_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rows@</string>
        <key>rows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d Zeile</string>
            <key>other</key>
            <string>%d Zeilen</string>
        </dict>
    </dict>
    <key>metric_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@metrics@</string>
        <key>metrics</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d Metrik</string>
            <key>other</key>
            <string>%d Metriken</string>
        </dict>
    </dict>
    <key>connection_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@connections@</string>
        <key>connections</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d Verbindung</string>
            <key>other</key>
            <string>%d Verbindungen</string>
        </dict>
    </dict>
</dict>
</plist>
