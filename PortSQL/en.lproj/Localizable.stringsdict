<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>column_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@columns@</string>
        <key>columns</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d column</string>
            <key>other</key>
            <string>%d columns</string>
        </dict>
    </dict>
    <key>column_count_short</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@columnsShort@</string>
        <key>columnsShort</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d col</string>
            <key>other</key>
            <string>%d cols</string>
        </dict>
    </dict>
    <key>affected_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rows@</string>
        <key>rows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d row affected</string>
            <key>other</key>
            <string>%d rows affected</string>
        </dict>
    </dict>
    <key>row_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rows@</string>
        <key>rows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d row</string>
            <key>other</key>
            <string>%d rows</string>
        </dict>
    </dict>
    <key>metric_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@metrics@</string>
        <key>metrics</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d metric</string>
            <key>other</key>
            <string>%d metrics</string>
        </dict>
    </dict>
    <key>connection_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@connections@</string>
        <key>connections</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d connection</string>
            <key>other</key>
            <string>%d connections</string>
        </dict>
    </dict>
</dict>
</plist>
